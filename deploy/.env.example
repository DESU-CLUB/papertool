# Bind all exposed service ports to your Tailscale host IP, e.g. 100.101.102.103
TAILSCALE_BIND_IP=127.0.0.1

COUCHDB_USER=papertool
COUCHDB_PASSWORD=papertool_change_me

MINIO_ROOT_USER=papertool
MINIO_ROOT_PASSWORD=papertool_minio_change_me

# Used by browser extension and remote API calls
PAPERTOOL_REMOTE_API_TOKEN=change_me_with_long_random_token
